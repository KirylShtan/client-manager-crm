pipeline {
    agent any

    tools {
        maven 'Maven'
        
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Check Maven') {
            steps {
                bat 'mvn -version'
            }
        }

        stage('Build & Test Backend') {
            steps {
                dir('backend') {
                    bat 'mvn clean test'
                    bat 'mvn package'
                    
                }
            }
        }

        stage('Deploy with Compose') {
            steps {
                bat 'docker-compose down || exit 0'
                bat 'docker-compose up -d --build'
            }
        }
    }

    post {
        always {
            echo 'Pipeline ended!'
        }
        failure {
            echo 'Something went wrong. Check logs.'
        }
    }
}