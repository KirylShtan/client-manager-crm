pipeline {
    agent any
    tools {
        jdk 'jdk21'
        maven 'Maven'
    }
    options {
        timestamps()
        disableConcurrentBuilds()
    }
    environment {
        MAVEN_OPTS = '-Xmx1024m -Dfile.encoding=UTF-8'
        COMPOSE_PROJECT_NAME = 'clientmanagercrm'
        SPRING_CLOUD_VAULT_URI = 'https://vault:8200'
        VAULT_SSL_TRUSTSTORE_PASSWORD = 'vaultdev'
        NODE_EXE = 'C:\\Program Files\\nodejs\\node.exe'
        NPM_CMD = 'C:\\Program Files\\nodejs\\npm.cmd'
        DOCKER_EXE = 'C:\\Program Files\\Docker\\Docker\\resources\\bin\\docker.exe'
        AWS_REGION = 'eu-central-1'
        AWS_ACCOUNT = '480582412233'
        AWS_EXE = 'C:\\Program Files\\Amazon\\AWSCLIV2\\aws.exe'
    }
    stages {
        stage('Checkout') {
            steps {
                deleteDir()
                checkout([
                    $class: 'GitSCM',
                    branches: scm.branches,
                    userRemoteConfigs: scm.userRemoteConfigs,
                    extensions: [[$class: 'CleanBeforeCheckout']]
                ])
            }
        }
        stage('AWS Preflight'){
            steps{
                withCredentials([
                    string(credentialsId: 'aws-access-key-id', variable:'AWS_ACCESS_KEY_ID'),
                    string(credentialsId: 'aws-secret-access-key', variable:'AWS_SECRET_ACCESS_KEY')
                ]){
                    bat '''
                    set ECR_REGISTRY=%AWS_ACCOUNT%.dkr.ecr.%AWS_REGION%.amazonaws.com
                    "%AWS_EXE%" --version
                    "%AWS_EXE%" sts get-caller-identity
                    "%AWS_EXE%" ecr get-login-password --region %AWS_REGION% | "%DOCKER_EXE%" login --username AWS --password-stdin %ECR_REGISTRY%
                    '''
                }
            }
        }
        stage('Prepare Vault Truststore') {
            steps {
                withCredentials([file(credentialsId: 'vault-truststore-jks', variable: 'VAULT_TRUSTSTORE_FILE')]) {
                    bat 'if not exist "backend\\src\\main\\resources" mkdir "backend\\src\\main\\resources"'
                    bat 'copy /Y "%VAULT_TRUSTSTORE_FILE%" "backend\\src\\main\\resources\\vault-truststore.jks"'
                    bat 'if not exist "backend\\src\\main\\resources\\vault-truststore.jks" (echo vault-truststore.jks MISSING & exit /b 1)'
                    bat 'echo vault-truststore.jks OK'
                }
            }
        }
        stage('Prepare Vault Key') {
            steps {
                withCredentials([file(credentialsId: 'vault-key', variable: 'VAULT_KEY_FILE')]) {
                    bat 'if not exist "vault_config\\tls" mkdir "vault_config\\tls"'
                    bat 'copy /Y "%VAULT_KEY_FILE%" "vault_config\\tls\\vault.key"'
                    bat 'if not exist "vault_config\\tls\\vault.key" (echo vault.key MISSING & exit /b 1)'
                    bat 'echo vault.key OK'
                }
            }
        }
        stage('Prepare Compose Env') {
            steps {
                withCredentials([file(credentialsId: 'compose-env-file', variable: 'COMPOSE_ENV_FILE')]) {
                    bat 'copy /Y "%COMPOSE_ENV_FILE%" ".env"'
                    bat 'if exist ".env" (echo .env PRESENT) else (echo .env MISSING & exit /b 1)'
                }
            }
        }
        stage('Tool Versions') {
            steps {
                bat 'echo JAVA_HOME=%JAVA_HOME%'
                bat 'where java'
                bat 'java -version'
                bat 'mvn -version'
                bat '"%NODE_EXE%" -v'
                bat '"%NPM_CMD%" -v'
                bat '"%DOCKER_EXE%" --version'
                bat '"%DOCKER_EXE%" compose version'
            }
        }
        stage('Backend Build & Test') {
            steps {
                dir('backend') {
                    bat 'mvn -B -U clean verify'
                }
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: 'backend/target/surefire-reports/*.xml'
                    archiveArtifacts artifacts: 'backend/target/*.jar, backend/target/surefire-reports/*', allowEmptyArchive: true
                }
            }
        }
        stage('Frontend Install & Test') {
            steps {
                withEnv(['PATH+NODE=C:\\Program Files\\nodejs']) {
                    dir('frontend') {
                        bat '"%NPM_CMD%" ci'
                        bat '"%NPM_CMD%" test -- --watchAll=false --passWithNoTests'
                    }
                }
            }
        }
        stage('Frontend Build') {
            steps {
                withEnv(['PATH+NODE=C:\\Program Files\\nodejs', 'CI=false']) {
                    dir('frontend') {
                        bat '"%NPM_CMD%" run build'
                    }
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'frontend/build/**', allowEmptyArchive: true
                }
            }
        }
        stage('Docker Compose Build') {
            steps {
                bat '"%DOCKER_EXE%" compose --env-file .env build --no-cache'
            }
        }
        stage('Docker Compose Up (Smoke)') {
            steps {
                bat '"%DOCKER_EXE%" compose --env-file .env up -d'
                bat 'ping 127.0.0.1 -n 21 >NUL'
                bat '"%DOCKER_EXE%" compose --env-file .env ps'
                bat '"%DOCKER_EXE%" compose --env-file .env logs mysqlServer --tail=120'
                bat '"%DOCKER_EXE%" compose --env-file .env logs backend --tail=120'
                bat '"%DOCKER_EXE%" compose --env-file .env logs vault --tail=120'
            }
        }
        stage('Vault Init/Unseal') {
            steps {
                withCredentials([
            string(credentialsId: 'vault-unseal-key-1', variable: 'VAULT_UNSEAL_KEY_1'),
            string(credentialsId: 'vault-unseal-key-2', variable: 'VAULT_UNSEAL_KEY_2'),
            string(credentialsId: 'vault-unseal-key-3', variable: 'VAULT_UNSEAL_KEY_3')
            ]) {
            bat '''
                @echo off
                setlocal ENABLEDELAYEDEXPANSION
                set VAULT_ADDR=https://localhost:8200
                rem checking status of vault
                curl -k -s %VAULT_ADDR%/v1/sys/health >NUL
                rem checking if vault is initialized
        "%DOCKER_EXE%" compose --env-file .env exec -T vault sh -lc "export VAULT_ADDR=https://127.0.0.1:8200; vault status -format=json > /tmp/vault_status.json"
        rem pulling initialized status from vault
        "%DOCKER_EXE%" compose --env-file .env exec -T vault sh -lc "cat /tmp/vault_status.json" > vault_status.json
        findstr /C:"\\"initialized\\":true" vault_status.json >NUL
        if %ERRORLEVEL%==0 (
          echo Vault already initialized.
        ) else (
          echo Vault is not initialized. Running init once...
          "%DOCKER_EXE%" compose --env-file .env exec -T vault sh -lc "export VAULT_ADDR=https://127.0.0.1:8200; vault operator init -key-shares=3 -key-threshold=3 -format=json > /tmp/vault_init.json"
          echo [ACTION REQUIRED] Vault initialized in container.
          echo Put generated unseal key into Jenkins credential: vault-unseal-key-1, vault-unseal-key-2, vault-unseal-key-3
          echo Re-run pipeline.
          exit /b 1
          
        )
        del /f /q vault_status.json vault_init.json 2>NUL
        rem unsealing vault
        "%DOCKER_EXE%" compose --env-file .env exec -T vault sh -lc "export VAULT_ADDR=https://127.0.0.1:8200; vault operator unseal %VAULT_UNSEAL_KEY_1%"
        "%DOCKER_EXE%" compose --env-file .env exec -T vault sh -lc "export VAULT_ADDR=https://127.0.0.1:8200; vault operator unseal %VAULT_UNSEAL_KEY_2%"
        "%DOCKER_EXE%" compose --env-file .env exec -T vault sh -lc "export VAULT_ADDR=https://127.0.0.1:8200; vault operator unseal %VAULT_UNSEAL_KEY_3%"
        rem waiting for vault to be ready
        for /f "delims=" %%i in ('curl -k -s -o NUL -w "%%{http_code}" https://localhost:8200/v1/sys/health') do set VCODE=%%i
        echo Vault health after unseal: !VCODE!
        if "!VCODE!"=="200" exit /b 0
        if "!VCODE!"=="429" exit /b 0
        echo Vault is not ready after unseal.
        exit /b 1
      '''
    }
  }
}

        stage('Smoke Health Checks') {
  steps {
    bat '''
      @echo off
      setlocal ENABLEDELAYEDEXPANSION
      set MAX_ATTEMPTS=15
      set ATTEMPT=1
      :health_loop
      set BACKEND_CODE=
      set VAULT_CODE=
      for /f "delims=" %%i in ('curl -s -o NUL -w "%%{http_code}" http://localhost:8080/actuator/health') do set BACKEND_CODE=%%i
      for /f "delims=" %%i in ('curl -k -s -o NUL -w "%%{http_code}" https://localhost:8200/v1/sys/health') do set VAULT_CODE=%%i
      echo Attempt !ATTEMPT!/!MAX_ATTEMPTS!: backend=!BACKEND_CODE! vault=!VAULT_CODE!
      rem backend: count 200 and 401 as OK
      set BACKEND_OK=0
      if "!BACKEND_CODE!"=="200" set BACKEND_OK=1
      if "!BACKEND_CODE!"=="401" set BACKEND_OK=1
      rem vault: ready if 200(active) or 429(standby)
      set VAULT_OK=0
      if "!VAULT_CODE!"=="200" set VAULT_OK=1
      if "!VAULT_CODE!"=="429" set VAULT_OK=1
      if "!BACKEND_OK!"=="1" if "!VAULT_OK!"=="1" (
        echo Smoke checks passed.
        exit /b 0
      )
      if !ATTEMPT! GEQ !MAX_ATTEMPTS! (
        echo Smoke checks FAILED. Final codes: backend=!BACKEND_CODE! vault=!VAULT_CODE!
        exit /b 1
      )
      set /a ATTEMPT+=1
      ping 127.0.0.1 -n 7 >NUL
      goto health_loop
    '''
  }
}
    }
    post {
        always {
            echo 'Cleaning up docker compose...'
            bat 'if exist ".env" (echo .env FOUND) else (echo .env MISSING)'
            bat 'if exist ".env" ("%DOCKER_EXE%" compose --env-file .env down) else (echo .env not found, skipping compose down)'
            echo 'Pipeline finished.'
        }
        failure {
            echo 'Pipeline failed. Check stage logs above.'
        }
        success {
            echo 'Pipeline succeeded.'
        }
    }
}
