pipeline {
    agent any
    tools {
        jdk 'jdk21'
        maven 'Maven'
    }
    options {
        timestamps()
        disableConcurrentBuilds()
    }
    environment {
        MAVEN_OPTS = '-Xmx1024m -Dfile.encoding=UTF-8'
        COMPOSE_PROJECT_NAME = 'clientmanagercrm'
        SPRING_CLOUD_VAULT_URI = 'https://vault:8200'
        VAULT_SSL_TRUSTSTORE_PASSWORD = 'vaultdev'
        NODE_EXE = 'C:\\Program Files\\nodejs\\node.exe'
        NPM_CMD = 'C:\\Program Files\\nodejs\\npm.cmd'
        DOCKER_EXE = 'C:\\Program Files\\Docker\\Docker\\resources\\bin\\docker.exe'
    }
    stages {
        stage('Checkout') {
            steps {
                deleteDir()
                checkout([
                    $class: 'GitSCM',
                    branches: scm.branches,
                    userRemoteConfigs: scm.userRemoteConfigs,
                    extensions: [[$class: 'CleanBeforeCheckout']]
                ])
            }
        }
        stage('Prepare Vault Truststore') {
            steps {
                withCredentials([file(credentialsId: 'vault-truststore-jks', variable: 'VAULT_TRUSTSTORE_FILE')]) {
                    bat 'copy /Y "%VAULT_TRUSTSTORE_FILE%" "backend\\src\\main\\resources\\vault-truststore.jks"'
                }
            }
        }
        stage('Prepare Compose Env') {
            steps {
                withCredentials([file(credentialsId: 'compose-env-file', variable: 'COMPOSE_ENV_FILE')]) {
                bat 'copy /Y "%COMPOSE_ENV_FILE%" ".env"'
                bat 'if exist ".env" (echo .env PRESENT) else (echo .env MISSING)'
                bat 'dir ".env"'
                bat 'if not exist ".env" exit /b 1'
                }
            }
        }
        stage('Tool Versions') {
            steps {
                bat 'echo JAVA_HOME=%JAVA_HOME%'
                bat 'where java'
                bat 'java -version'
                bat 'mvn -version'
                bat '"%NODE_EXE%" -v'
                bat '"%NPM_CMD%" -v'
                bat '"%DOCKER_EXE%" --version'
                bat '"%DOCKER_EXE%" compose version'
            }
        }
        stage('Backend Build & Test') {
            steps {
                dir('backend') {
                    bat 'mvn -B -U clean verify'
                }
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: 'backend/target/surefire-reports/*.xml'
                    archiveArtifacts artifacts: 'backend/target/*.jar, backend/target/surefire-reports/*', allowEmptyArchive: true
                }
            }
        }
        stage('Frontend Install & Test') {
            steps {
                withEnv(['PATH+NODE=C:\\Program Files\\nodejs']) {
                    dir('frontend') {
                        bat '"%NPM_CMD%" ci'
                        bat '"%NPM_CMD%" test -- --watchAll=false --passWithNoTests'
                    }
                }
            }
        }
        stage('Frontend Build') {
            steps {
                withEnv(['PATH+NODE=C:\\Program Files\\nodejs', 'CI=false']) {
                    dir('frontend') {
                        bat '"%NPM_CMD%" run build'
                    }
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'frontend/build/**', allowEmptyArchive: true
                }
            }
        }
        stage('Docker Compose Build') {
            steps {
                bat '"%DOCKER_EXE%" compose --env-file .env build --no-cache'
            }
        }
        stage('Docker Compose Up (Smoke)') {
            steps {
                bat '"%DOCKER_EXE%" compose --env-file .env up -d'
                bat 'powershell -Command "Start-Sleep -Seconds 20"'
                bat '"%DOCKER_EXE%" compose --env-file .env ps'
                bat '"%DOCKER_EXE%" compose --env-file .env logs mysqlServer --tail=120'
                bat '"%DOCKER_EXE%" compose --env-file .env logs backend --tail=120'
                bat '"%DOCKER_EXE%" compose --env-file .env logs vault --tail=120'
            }
        }
        stage('Smoke Health Checks') {
            steps {
                bat 'curl -f http://localhost:8080/actuator/health'
                bat 'curl -k -f https://localhost:8200/v1/sys/health'
            }
        }
    }
    post {
        always {
            echo 'Cleaning up docker compose...'
            bat 'if exist ".env" ("%DOCKER_EXE%" compose --env-file .env down) else (echo .env not found, skipping compose down)'
            echo 'Pipeline finished.'
        }
        failure {
            echo 'Pipeline failed. Check stage logs above.'
        }
        success {
            echo 'Pipeline succeeded.'
        }
    }
}