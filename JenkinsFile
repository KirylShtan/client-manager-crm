pipeline {
    agent any

    tools {
        maven 'Maven'
        nodejs 'NodeJS' 
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Check Maven') {
            steps {
                bat 'mvn -version'
            }
        }

        stage('Build & Test Backend') {
            steps {
                dir('backend') {
                    bat 'mvn clean test'
                    bat 'mvn package'
                    bat 'docker build -t client_management-backend:latest .'
                }
            }
        }

        stage('Build Frontend') {
            steps {
                dir('frontend') {
                    bat 'npm install'
                    bat 'npm run build'
                    bat 'docker build -t client_management-frontend:latest .'
                }
            }
        }

        stage('Deploy with Compose') {
            steps {
                bat 'docker-compose down || exit 0'
                bat 'docker-compose up -d --build'
            }
        }
    }

    post {
        always {
            echo 'Pipeline ended!'
        }
        failure {
            echo 'Something went wrong. Check logs.'
        }
    }
}