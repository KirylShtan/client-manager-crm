pipeline {
    agent any
    tools {
        jdk 'jdk21'
        maven 'Maven'
    }
    options {
        timestamps()
        disableConcurrentBuilds()
    }
    environment {
        MAVEN_OPTS = '-Xmx1024m -Dfile.encoding=UTF-8'
        COMPOSE_PROJECT_NAME = 'clientmanagercrm'
        SPRING_CLOUD_VAULT_URI = 'https://vault:8200'
        VAULT_SSL_TRUSTSTORE_PASSWORD = 'vaultdev'
        NODE_EXE = 'C:\\Program Files\\nodejs\\node.exe'
        NPM_CMD = 'C:\\Program Files\\nodejs\\npm.cmd'
        DOCKER_EXE = 'C:\\Program Files\\Docker\\Docker\\resources\\bin\\docker.exe'
    }
    stages {
        stage('Checkout') {
            steps {
                deleteDir()
                checkout([
                    $class: 'GitSCM',
                    branches: scm.branches,
                    userRemoteConfigs: scm.userRemoteConfigs,
                    extensions: [[$class: 'CleanBeforeCheckout']]
                ])
            }
        }
        stage('Prepare Vault Truststore') {
            steps {
                withCredentials([file(credentialsId: 'vault-truststore-jks', variable: 'VAULT_TRUSTSTORE_FILE')]) {
                    bat 'copy /Y "%VAULT_TRUSTSTORE_FILE%" "backend\\src\\main\\resources\\vault-truststore.jks"'
                }
            }
        }
        stage('Tool Versions') {
            steps {
                bat 'echo JAVA_HOME=%JAVA_HOME%'
                bat 'where java'
                bat 'java -version'
                bat 'mvn -version'
                bat '"%NODE_EXE%" -v'
                bat '"%NPM_CMD%" -v'
                bat '"%DOCKER_EXE%" --version'
                bat '"%DOCKER_EXE%" compose version'
            }
        }
        stage('Backend Build & Test') {
            steps {
                dir('backend') {
                    bat 'mvn -B -U clean verify'
                }
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: 'backend/target/surefire-reports/*.xml'
                    archiveArtifacts artifacts: 'backend/target/*.jar, backend/target/surefire-reports/*', allowEmptyArchive: true
                }
            }
        }
        stage('Frontend Install & Test') {
            steps {
                withEnv(['PATH+NODE=C:\\Program Files\\nodejs']) {
                    dir('frontend') {
                        bat '"%NPM_CMD%" ci'
                        bat '"%NPM_CMD%" test -- --watchAll=false --passWithNoTests'
                    }
                }
            }
        }
        stage('Frontend Build') {
            steps {
                withEnv(['PATH+NODE=C:\\Program Files\\nodejs', 'CI=false']) {
                    dir('frontend') {
                        bat '"%NPM_CMD%" run build'
                    }
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'frontend/build/**', allowEmptyArchive: true
                }
            }
        }
        stage('Prepare Compose Env') {
    steps {
        withCredentials([
            string(credentialsId: 'MYSQL_ROOT_PASSWORD', variable: 'MYSQL_ROOT_PASSWORD'),
            string(credentialsId: 'MYSQL_DATABASE', variable: 'MYSQL_DATABASE'),
            string(credentialsId: 'SPRING_DATASOURCE_USERNAME', variable: 'SPRING_DATASOURCE_USERNAME'),
            string(credentialsId: 'SPRING_DATASOURCE_PASSWORD', variable: 'SPRING_DATASOURCE_PASSWORD'),
            string(credentialsId: 'SECURITY_USER_NAME', variable: 'SECURITY_USER_NAME'),
            string(credentialsId: 'SECURITY_USER_PASSWORD', variable: 'SECURITY_USER_PASSWORD'),
            string(credentialsId: 'JWT_SECRET_KEY', variable: 'JWT_SECRET_KEY'),
            string(credentialsId: 'VAULT_SECRET_TOKEN', variable: 'VAULT_SECRET_TOKEN'),
            string(credentialsId: 'SPRING_CLOUD_VAULT_TOKEN', variable: 'SPRING_CLOUD_VAULT_TOKEN'),
            string(credentialsId: 'TELEGRAM_BOT_TOKEN', variable: 'TELEGRAM_BOT_TOKEN'),
            string(credentialsId: 'TELEGRAM_WEBHOOK_SECRET', variable: 'TELEGRAM_WEBHOOK_SECRET'),
            string(credentialsId: 'MAIL_USERNAME', variable: 'MAIL_USERNAME'),
            string(credentialsId: 'MAIL_PASSWORD', variable: 'MAIL_PASSWORD'),
            string(credentialsId: 'PMA_HOST', variable: 'PMA_HOST'),
            string(credentialsId: 'PMA_USER', variable: 'PMA_USER'),
            string(credentialsId: 'PMA_PASSWORD', variable: 'PMA_PASSWORD'),
            string(credentialsId: 'VAULT_API_ADDR', variable: 'VAULT_API_ADDR'),
            string(credentialsId: 'VAULT_ADDR', variable: 'VAULT_ADDR'),
            string(credentialsId: 'VAULT_CACERT', variable: 'VAULT_CACERT')
        ]) {
                    writeFile file: '.env', text: """
            MYSQL_ROOT_PASSWORD=${MYSQL_ROOT_PASSWORD}
            MYSQL_DATABASE=${MYSQL_DATABASE}
            SPRING_DATASOURCE_USERNAME=${SPRING_DATASOURCE_USERNAME}
            SPRING_DATASOURCE_PASSWORD=${SPRING_DATASOURCE_PASSWORD}
            SECURITY_USER_NAME=${SECURITY_USER_NAME}
            SECURITY_USER_PASSWORD=${SECURITY_USER_PASSWORD}
            JWT_SECRET_KEY=${JWT_SECRET_KEY}
            VAULT_SECRET_TOKEN=${VAULT_SECRET_TOKEN}
            SPRING_CLOUD_VAULT_TOKEN=${SPRING_CLOUD_VAULT_TOKEN}
            TELEGRAM_BOT_TOKEN=${TELEGRAM_BOT_TOKEN}
            TELEGRAM_WEBHOOK_SECRET=${TELEGRAM_WEBHOOK_SECRET}
            MAIL_USERNAME=${MAIL_USERNAME}
            MAIL_PASSWORD=${MAIL_PASSWORD}
            PMA_HOST=${PMA_HOST}
            PMA_USER=${PMA_USER}
            PMA_PASSWORD=${PMA_PASSWORD}
            VAULT_API_ADDR=${VAULT_API_ADDR}
            VAULT_ADDR=${VAULT_ADDR}
            VAULT_CACERT=${VAULT_CACERT}
            """.trim()
                    }
                }
            }
        stage('Docker Compose Build') {
            steps {
                bat '"%DOCKER_EXE%" compose build --no-cache'
            }
        }
        stage('Docker Compose Up (Smoke)') {
            steps {
                bat '"%DOCKER_EXE%" compose up -d'
                bat 'powershell -Command "Start-Sleep -Seconds 20"'
                bat '"%DOCKER_EXE%" compose ps'
                bat '"%DOCKER_EXE%" compose logs backend --tail=120'
                bat '"%DOCKER_EXE%" compose logs vault --tail=120'
            }
        }
        stage('Smoke Health Checks') {
            steps {
                bat 'curl -f http://localhost:8080/actuator/health'
                bat 'curl -k -f https://localhost:8200/v1/sys/health'
            }
        }
    }
    post {
        always {
            echo 'Cleaning up docker compose...'
            bat 'if exist "%DOCKER_EXE%" "%DOCKER_EXE%" compose down'
            echo 'Pipeline finished.'
        }
        failure {
            echo 'Pipeline failed. Check stage logs above.'
        }
        success {
            echo 'Pipeline succeeded.'
        }
    }
}