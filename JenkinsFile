pipeline {
    agent any

    stages{
        stage('Checkout'){
            steps{
                checkout scm
            }
        }
        stage('Build & Dockerize Backend'){
            when{ changeset "**/backend/**"}
            steps{
                drr('backend'){
                    sh 'mvn clean package -DskipTests'
                }
                sh 'docker build  -t client_management-backend:latest ./backend'
            }
        }
        stage('Build & Dockerize Frontend'){
            when {changeset "**/frontend/**"}
            steps{
                dir('frontend'){
                    sh 'npm istall'
                    sh 'npm run build'
                }
                sh 'docker build  -t  client_management-frontend:latest ./frontend'
            }
        }
        stage('Deploy with Compose'){
            steps {
                sh 'docker compose down || true'
                sh 'docker compose up -d --build'
            }
        }
    }
    post {
        always{
            echo 'Pipeline ended!'
        }
        success{
            echo 'Everything built and deployed '
        }
        failure{
            echo 'Something wrong....'
        }
    }
}