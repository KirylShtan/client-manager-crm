pipeline {
    agent any

    tools {
        maven 'Maven'
        
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Check Maven') {
            steps {
                echo 'Проверяем Maven...'
                bat '"${tool "Maven"}\\bin\\mvn" -version'
            }
        }

        stage('Build & Test Backend') {
            steps {
                echo 'Собираем и тестируем backend...'
                dir('backend') {
                    bat '"${tool "Maven"}\\bin\\mvn" clean test'
                    bat '"${tool "Maven"}\\bin\\mvn" package'
                    bat 'docker build -t client_management-backend:latest .'
                }
            }
        }

        stage('Build Frontend') {
            steps {
                echo 'Собираем frontend без тестов...'
                dir('frontend') {
                    bat 'npm install'
                    bat 'npm run build'
                    bat 'docker build -t client_management-frontend:latest .'
                }
            }
        }

        stage('Deploy with Compose') {
            steps {
                echo 'Останавливаем старые контейнеры...'
                bat 'docker-compose down || exit 0'

                echo 'Запускаем новые контейнеры...'
                bat 'docker-compose up -d --build'

                echo 'Приложение обновлено!'
                echo 'Frontend: http://localhost:3000'
                echo 'Backend: http://localhost:8080'
            }
        }
    }

    post {
        always {
            echo 'Pipeline ended!'
        }
        success {
            echo 'Backend tested, all built and deployed successfully 🚀'
        }
        failure {
            echo 'Something went wrong 😔 Check the logs above.'
        }
    }
}