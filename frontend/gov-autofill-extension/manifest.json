{
  "manifest_version": 3,
  "name": "Gov Case Autofill",
  "version": "1.0.0",
  "description": "Autofills case number and code on gov status page",
  "permissions": [],
  "host_permissions": [
    "https://www.poznan.uw.gov.pl/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.poznan.uw.gov.pl/cudzoziemcy-stan/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}